NODE_ENV=development
PORT=4000
PUBLIC_API_URL=http://localhost:4000
STORAGE_DIR=storage
# S3-compatible bucket for uploads (Cloudflare R2, AWS S3, Supabase). Set all four or none;
# without them files are kept in STORAGE_DIR. For R2 the endpoint is
# https://<account id>.r2.cloudflarestorage.com and the region stays "auto".
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
DATABASE_URL="postgresql://neonadda:neonadda@localhost:5433/neonadda?schema=public"
REDIS_URL="redis://localhost:6379"
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003"
# Proxies in front of the API that add to X-Forwarded-For (Render: 1). With the right number, the
# "signed in from" notice shows the visitor's real IP; if it shows a Render or Cloudflare address,
# raise this to 2.
TRUST_PROXY_HOPS=1

# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# Share sign-in cookies across subdomains in production, e.g. .neonadda.com
COOKIE_DOMAIN=
COOKIE_SECURE=false
# Force staff to set up an authenticator app before using the admin panel.
REQUIRE_ADMIN_2FA=false

# WhatsApp Cloud API (Meta Business > WhatsApp > API setup). While these are empty the API
# runs in preview mode: one-time codes are not sent and appear on the sign-in screen instead.
META_WA_ACCESS_TOKEN=
META_WA_PHONE_NUMBER_ID=
# Name and language of the approved authentication template that carries the code.
META_WA_OTP_TEMPLATE=login_code
META_WA_TEMPLATE_LANGUAGE=en
# The code every number signs in with until WhatsApp is connected.
OTP_PREVIEW_CODE=1234

# Design assistant. Gemini (aistudio.google.com > Get API key) is used when its key is set,
# otherwise Claude (console.anthropic.com). With neither, the assistant is hidden.
GEMINI_API_KEY=
GEMINI_MODELS=gemini-flash-latest,gemini-3-flash-preview,gemini-3.1-flash-lite
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Suggestions allowed per day across all visitors, to cap the bill.
ASSISTANT_DAILY_LIMIT=300

# AI rooms behind the 3D sign preview (/create on the storefront): painters tried in order, the
# sign itself is never painted by AI. "cloudflare" goes first: it is free and fast. "gemini" uses GEMINI_API_KEY
# but needs billing switched on for the Google AI Studio project (free keys have no image quota);
# "gemini-svg" has Gemini's text models draw vector artwork and works on a free key.
# "cloudflare" needs a free Cloudflare account: the account ID and an API token with Workers AI
# permission. "pollinations" allows a few images per address without a key; a key from
# enter.pollinations.ai lifts that.
IMAGE_PROVIDERS=cloudflare,gemini,gemini-svg
GEMINI_IMAGE_MODELS=gemini-3.1-flash-image,gemini-2.5-flash-image
GEMINI_SVG_MODELS=gemini-3-flash-preview,gemini-flash-latest,gemini-3.7-flash,gemini-3.6-flash
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
POLLINATIONS_API_KEY=
# Pictures each signed-in customer may make per day.
ARTWORK_PER_CUSTOMER_DAILY=5
# Pictures allowed per day across all visitors. 0 hides the AI designer.
ARTWORK_DAILY_LIMIT=150

# Firebase service account (Project settings > Service accounts). Leave empty to disable push.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Razorpay, for "Pay now" at checkout. Leave empty for cash on delivery only. Use the rzp_test_
# keys until the account is activated. The webhook secret is the one you set on the webhook in the
# Razorpay dashboard (Settings > Webhooks), pointing at <API>/v1/payments/razorpay/webhook.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Minutes a customer has to pay online before an unpaid order lapses.
ONLINE_PAYMENT_WINDOW_MINUTES=30
