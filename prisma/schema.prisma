// Money is stored as BigInt paise (columns suffixed "Paise"), rates as Decimal rupees,
// dimensions in inches and areas in square feet.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Enums ───────────────────────────────

enum UserType {
  CUSTOMER
  STAFF
  FRANCHISE
  TECHNICIAN
}

enum AuthAudience {
  CUSTOMER
  ADMIN
  FRANCHISE
  TECHNICIAN
}

enum UserStatus {
  ACTIVE
  BLOCKED
  DELETED
}

enum ProductType {
  TEXT_NEON
  LOGO_NEON
  READYMADE
  BUSINESS
}

enum PricingMode {
  INSTANT
  QUOTE
}

enum DesignMode {
  TEXT
  LOGO
}

enum AddonPricingType {
  FLAT
  PER_SQFT
  PERCENT
}

enum InstallChargeType {
  FLAT
  PER_SQFT
}

enum RateCardStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CouponType {
  PERCENT
  FLAT
}

enum OrderChannel {
  WEB
  KIOSK
  FRANCHISE_PORTAL
  ADMIN
  QUOTE
}

enum AttributionSource {
  SELF_SOURCED
  ASSIGNED
  NONE
}

enum OrderStatus {
  PENDING_PAYMENT
  EXPIRED
  CONFIRMED
  PROOF_PENDING
  PROOF_APPROVED
  IN_PRODUCTION
  QUALITY_CHECK
  READY_TO_DISPATCH
  SHIPPED
  DELIVERED
  INSTALLED
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum OrderPaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentMode {
  FULL
  ADVANCE
}

enum PaymentPurpose {
  FULL
  ADVANCE
  BALANCE
}

enum PaymentMethod {
  RAZORPAY
  PAYMENT_LINK
  UPI_QR
  OFFLINE_CASH
  OFFLINE_UPI
  OFFLINE_BANK
}

enum PaymentTxnStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}

enum QuotationStatus {
  REQUESTED
  IN_REVIEW
  SENT
  CHANGES_REQUESTED
  ACCEPTED
  REJECTED
  EXPIRED
}

enum ProofStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  SUPERSEDED
}

enum InvoiceType {
  TAX_INVOICE
  CREDIT_NOTE
}

enum FranchiseStatus {
  PENDING_KYC
  ACTIVE
  SUSPENDED
}

enum CommissionScope {
  DEFAULT
  TIER
  FRANCHISE
}

enum CommissionRuleSource {
  SELF_SOURCED
  ASSIGNED
  ANY
}

enum CommissionType {
  PERCENT
  FLAT
}

enum CommissionKind {
  ORDER
  ADJUSTMENT
}

enum CommissionStatus {
  PENDING
  ELIGIBLE
  APPROVED
  PAID
  REVERSED
  ON_HOLD
}

enum PayoutStatus {
  DRAFT
  PAID
  CANCELLED
}

enum JobStatus {
  UNASSIGNED
  SCHEDULED
  ON_THE_WAY
  REACHED
  WORK_STARTED
  COMPLETED
  RESCHEDULED
  FAILED
}

enum JobPhotoStage {
  BEFORE
  DURING
  AFTER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUOTED
  WON
  LOST
}

enum NotificationChannel {
  SMS
  WHATSAPP
  EMAIL
  IN_APP
}

enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

enum UploadKind {
  LOGO
  WALL
  PROOF
  JOB_PHOTO
  KYC
  PRODUCT
}

// ───────────────────────── Identity & access ─────────────────────────

model User {
  id               String     @id @default(uuid(7)) @db.Uuid
  type             UserType
  phone            String?    @unique @db.VarChar(15)
  email            String?    @unique @db.VarChar(120)
  name             String?    @db.VarChar(80)
  passwordHash     String?
  totpSecret       Bytes?
  status           UserStatus @default(ACTIVE)
  franchiseId      String?    @db.Uuid
  failedLoginCount Int        @default(0)
  lockedUntil      DateTime?  @db.Timestamptz
  lastLoginAt      DateTime?  @db.Timestamptz
  deletedAt        DateTime?  @db.Timestamptz
  createdAt        DateTime   @default(now()) @db.Timestamptz
  updatedAt        DateTime   @updatedAt @db.Timestamptz

  franchise       Franchise?     @relation("FranchiseUsers", fields: [franchiseId], references: [id])
  ownedFranchises Franchise[]    @relation("FranchiseOwner")
  addresses       Address[]
  roles           UserRole[]
  sessions        Session[]
  designs         Design[]
  carts           Cart[]
  quotations      Quotation[]
  orders          Order[]        @relation("CustomerOrders")
  reviews         Review[]
  uploads         Upload[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  pushDevices     PushDevice[]
  technician      Technician?

  @@index([franchiseId])
  @@map("users")
}

model Address {
  id           String   @id @default(uuid(7)) @db.Uuid
  userId       String   @db.Uuid
  label        String?  @db.VarChar(30)
  name         String   @db.VarChar(80)
  phone        String   @db.VarChar(15)
  line1        String   @db.VarChar(160)
  line2        String?  @db.VarChar(160)
  landmark     String?  @db.VarChar(160)
  city         String   @db.VarChar(80)
  stateCode    String   @db.VarChar(2)
  pincode      String   @db.Char(6)
  gstin        String?  @db.VarChar(15)
  businessName String?  @db.VarChar(120)
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

model Role {
  id          String           @id @default(uuid(7)) @db.Uuid
  key         String           @unique @db.VarChar(40)
  name        String           @db.VarChar(80)
  isSystem    Boolean          @default(false)
  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id    String           @id @default(uuid(7)) @db.Uuid
  key   String           @unique @db.VarChar(60)
  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Session {
  id          String       @id @default(uuid(7)) @db.Uuid
  userId      String       @db.Uuid
  audience    AuthAudience
  refreshHash String       @unique @db.Char(64)
  familyId    String       @db.Uuid
  userAgent   String?
  ip          String?      @db.VarChar(45)
  expiresAt   DateTime     @db.Timestamptz
  revokedAt   DateTime?    @db.Timestamptz
  createdAt   DateTime     @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model KioskDevice {
  id          String    @id @default(uuid(7)) @db.Uuid
  franchiseId String    @db.Uuid
  name        String    @db.VarChar(60)
  tokenHash   String    @unique @db.Char(64)
  lastSeenAt  DateTime? @db.Timestamptz
  revokedAt   DateTime? @db.Timestamptz
  createdAt   DateTime  @default(now()) @db.Timestamptz

  franchise Franchise @relation(fields: [franchiseId], references: [id])
  orders    Order[]

  @@index([franchiseId])
  @@map("kiosk_devices")
}

// ─────────────────────────── Catalogue & studio ───────────────────────────

model Category {
  id        String    @id @default(uuid(7)) @db.Uuid
  parentId  String?   @db.Uuid
  name      String    @db.VarChar(80)
  slug      String    @unique @db.VarChar(100)
  imageKey  String?
  sort      Int       @default(0)
  isActive  Boolean   @default(true)
  seo       Json?
  deletedAt DateTime? @db.Timestamptz
  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz

  parent          Category?        @relation("CategoryTree", fields: [parentId], references: [id])
  children        Category[]       @relation("CategoryTree")
  products        Product[]
  orderItems      OrderItem[]
  commissionRules CommissionRule[]

  @@map("categories")
}

model Product {
  id            String      @id @default(uuid(7)) @db.Uuid
  categoryId    String      @db.Uuid
  type          ProductType
  pricingMode   PricingMode @default(INSTANT)
  name          String      @db.VarChar(120)
  slug          String      @unique @db.VarChar(140)
  description   String?
  specs         Json?
  defaultDesign Json?
  images        Json?
  minWidthIn    Decimal     @default(12) @db.Decimal(6, 2)
  maxWidthIn    Decimal     @default(96) @db.Decimal(6, 2)
  minHeightIn   Decimal     @default(4) @db.Decimal(6, 2)
  maxHeightIn   Decimal     @default(60) @db.Decimal(6, 2)
  rateOverride  Decimal?    @db.Decimal(12, 2)
  leadTimeDays  Int         @default(7)
  isActive      Boolean     @default(true)
  isFeatured    Boolean     @default(false)
  tags          String[]
  seo           Json?
  deletedAt     DateTime?   @db.Timestamptz
  createdAt     DateTime    @default(now()) @db.Timestamptz
  updatedAt     DateTime    @updatedAt @db.Timestamptz

  category   Category    @relation(fields: [categoryId], references: [id])
  designs    Design[]
  orderItems OrderItem[]

  @@index([categoryId])
  @@index([tags], type: Gin)
  @@map("products")
}

model Font {
  id             String   @id @default(uuid(7)) @db.Uuid
  name           String   @db.VarChar(60)
  family         String   @db.VarChar(80)
  fileKey        String?
  styleTag       String   @db.VarChar(20)
  supportedChars String?
  isActive       Boolean  @default(true)
  sort           Int      @default(0)
  createdAt      DateTime @default(now()) @db.Timestamptz

  @@map("fonts")
}

model NeonColor {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @db.VarChar(40)
  tubeHex   String   @db.Char(7)
  glowHex   String   @db.Char(7)
  isRgb     Boolean  @default(false)
  isActive  Boolean  @default(true)
  sort      Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz

  @@map("neon_colors")
}

model Backboard {
  id          String   @id @default(uuid(7)) @db.Uuid
  code        String   @unique @db.VarChar(20)
  name        String   @db.VarChar(60)
  material    String   @db.VarChar(40)
  shape       String   @db.VarChar(20)
  description String?
  imageKey    String?
  isActive    Boolean  @default(true)
  sort        Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamptz

  rateEntries RateCardEntry[]

  @@map("backboards")
}

model Background {
  id        String   @id @default(uuid(7)) @db.Uuid
  code      String   @unique @db.VarChar(30)
  name      String   @db.VarChar(60)
  imageKey  String?
  pxPerInch Decimal? @db.Decimal(6, 2)
  isActive  Boolean  @default(true)
  sort      Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz

  @@map("backgrounds")
}

model Design {
  id              String     @id @default(uuid(7)) @db.Uuid
  userId          String?    @db.Uuid
  guestToken      String?    @db.VarChar(64)
  productId       String     @db.Uuid
  mode            DesignMode
  config          Json
  widthIn         Decimal    @db.Decimal(6, 2)
  heightIn        Decimal    @db.Decimal(6, 2)
  areaSqft        Decimal    @db.Decimal(10, 2)
  previewKey      String?
  tracedSvgKey    String?
  complexityScore Decimal?   @db.Decimal(10, 2)
  shareSlug       String?    @unique @db.VarChar(20)
  isSaved         Boolean    @default(false)
  createdAt       DateTime   @default(now()) @db.Timestamptz
  updatedAt       DateTime   @updatedAt @db.Timestamptz

  user       User?       @relation(fields: [userId], references: [id])
  product    Product     @relation(fields: [productId], references: [id])
  cartItems  CartItem[]
  orderItems OrderItem[]
  quotations Quotation[]

  @@index([userId])
  @@index([guestToken])
  @@map("designs")
}

model Upload {
  id          String     @id @default(uuid(7)) @db.Uuid
  ownerUserId String?    @db.Uuid
  kind        UploadKind
  s3Key       String
  mime        String     @db.VarChar(80)
  bytes       Int
  width       Int?
  height      Int?
  status      String     @default("PENDING") @db.VarChar(20)
  createdAt   DateTime   @default(now()) @db.Timestamptz

  owner User? @relation(fields: [ownerUserId], references: [id])

  @@map("uploads")
}

// ─────────────────────────────── Pricing ───────────────────────────────

model RateCardVersion {
  id            String         @id @default(uuid(7)) @db.Uuid
  versionNo     Int            @unique
  status        RateCardStatus @default(DRAFT)
  effectiveFrom DateTime       @db.Timestamptz
  notes         String?
  publishedBy   String?        @db.Uuid
  publishedAt   DateTime?      @db.Timestamptz
  createdAt     DateTime       @default(now()) @db.Timestamptz

  entries RateCardEntry[]

  @@index([status, effectiveFrom])
  @@map("rate_card_versions")
}

model RateCardEntry {
  id              String      @id @default(uuid(7)) @db.Uuid
  versionId       String      @db.Uuid
  productType     ProductType
  backboardId     String      @db.Uuid
  ratePerSqft     Decimal     @db.Decimal(12, 2)
  minBillableSqft Decimal     @default(1) @db.Decimal(6, 2)

  version   RateCardVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  backboard Backboard       @relation(fields: [backboardId], references: [id])

  @@unique([versionId, productType, backboardId])
  @@map("rate_card_entries")
}

model Addon {
  id          String           @id @default(uuid(7)) @db.Uuid
  code        String           @unique @db.VarChar(30)
  name        String           @db.VarChar(80)
  pricingType AddonPricingType
  /// paise for FLAT / PER_SQFT, percent for PERCENT
  value       Decimal          @db.Decimal(12, 2)
  appliesTo   ProductType[]
  isActive    Boolean          @default(true)
  sort        Int              @default(0)
  createdAt   DateTime         @default(now()) @db.Timestamptz

  @@map("addons")
}

model ServiceZone {
  id                     String            @id @default(uuid(7)) @db.Uuid
  code                   String            @unique @db.VarChar(30)
  name                   String            @db.VarChar(60)
  deliveryChargePaise    BigInt            @default(0)
  freeDeliveryAbovePaise BigInt?
  installAvailable       Boolean           @default(false)
  installType            InstallChargeType @default(PER_SQFT)
  installValuePaise      BigInt            @default(0)
  deliveryDaysMin        Int               @default(5)
  deliveryDaysMax        Int               @default(7)
  isActive               Boolean           @default(true)
  createdAt              DateTime          @default(now()) @db.Timestamptz

  pincodes ZonePincode[]

  @@map("service_zones")
}

model ZonePincode {
  id      String @id @default(uuid(7)) @db.Uuid
  zoneId  String @db.Uuid
  pincode String @unique @db.Char(6)

  zone ServiceZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@map("zone_pincodes")
}

model Pincode {
  pincode   String @id @db.Char(6)
  city      String @db.VarChar(80)
  district  String @db.VarChar(80)
  stateCode String @db.VarChar(2)

  @@map("pincodes")
}

model Coupon {
  id               String     @id @default(uuid(7)) @db.Uuid
  code             String     @unique @db.VarChar(20)
  type             CouponType
  value            Decimal    @db.Decimal(12, 2)
  maxDiscountPaise BigInt?
  minOrderPaise    BigInt?
  startsAt         DateTime   @db.Timestamptz
  endsAt           DateTime?  @db.Timestamptz
  usageLimit       Int?
  perUserLimit     Int?
  firstOrderOnly   Boolean    @default(false)
  categoryIds      String[]   @db.Uuid
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now()) @db.Timestamptz

  redemptions CouponRedemption[]
  carts       Cart[]
  orders      Order[]

  @@map("coupons")
}

model CouponRedemption {
  id            String   @id @default(uuid(7)) @db.Uuid
  couponId      String   @db.Uuid
  orderId       String   @db.Uuid
  userId        String   @db.Uuid
  discountPaise BigInt
  createdAt     DateTime @default(now()) @db.Timestamptz

  coupon Coupon @relation(fields: [couponId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id])

  @@unique([couponId, orderId])
  @@map("coupon_redemptions")
}

model Setting {
  key       String   @id @db.VarChar(60)
  value     Json
  updatedBy String?  @db.Uuid
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@map("settings")
}

// ──────────────────────────────── Sales ────────────────────────────────

model Cart {
  id                  String    @id @default(uuid(7)) @db.Uuid
  userId              String?   @db.Uuid
  guestToken          String?   @unique @db.VarChar(64)
  couponId            String?   @db.Uuid
  referralFranchiseId String?   @db.Uuid
  pricedAt            DateTime? @db.Timestamptz
  createdAt           DateTime  @default(now()) @db.Timestamptz
  updatedAt           DateTime  @updatedAt @db.Timestamptz

  user              User?      @relation(fields: [userId], references: [id])
  coupon            Coupon?    @relation(fields: [couponId], references: [id])
  referralFranchise Franchise? @relation(fields: [referralFranchiseId], references: [id])
  items             CartItem[]

  @@index([userId])
  @@map("carts")
}

model CartItem {
  id             String   @id @default(uuid(7)) @db.Uuid
  cartId         String   @db.Uuid
  designId       String   @db.Uuid
  qty            Int      @default(1)
  unitPricePaise BigInt
  priceSnapshot  Json
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz

  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)
  design Design @relation(fields: [designId], references: [id])

  @@map("cart_items")
}

model Quotation {
  id             String          @id @default(uuid(7)) @db.Uuid
  quoteNo        String          @db.VarChar(20)
  version        Int             @default(1)
  customerId     String          @db.Uuid
  franchiseId    String?         @db.Uuid
  leadId         String?         @db.Uuid
  designId       String?         @db.Uuid
  status         QuotationStatus @default(REQUESTED)
  requestDetails Json?
  subtotalPaise  BigInt          @default(0)
  discountPaise  BigInt          @default(0)
  taxablePaise   BigInt          @default(0)
  cgstPaise      BigInt          @default(0)
  sgstPaise      BigInt          @default(0)
  igstPaise      BigInt          @default(0)
  totalPaise     BigInt          @default(0)
  validUntil     DateTime?       @db.Timestamptz
  terms          String?
  notes          String?
  pdfKey         String?
  sentAt         DateTime?       @db.Timestamptz
  respondedAt    DateTime?       @db.Timestamptz
  createdBy      String?         @db.Uuid
  createdAt      DateTime        @default(now()) @db.Timestamptz
  updatedAt      DateTime        @updatedAt @db.Timestamptz

  customer  User            @relation(fields: [customerId], references: [id])
  franchise Franchise?      @relation(fields: [franchiseId], references: [id])
  lead      Lead?           @relation(fields: [leadId], references: [id])
  design    Design?         @relation(fields: [designId], references: [id])
  items     QuotationItem[]
  orders    Order[]

  @@unique([quoteNo, version])
  @@index([customerId])
  @@index([franchiseId])
  @@index([status])
  @@map("quotations")
}

model QuotationItem {
  id             String   @id @default(uuid(7)) @db.Uuid
  quotationId    String   @db.Uuid
  description    String
  widthIn        Decimal? @db.Decimal(6, 2)
  heightIn       Decimal? @db.Decimal(6, 2)
  areaSqft       Decimal? @db.Decimal(10, 2)
  ratePerSqft    Decimal? @db.Decimal(12, 2)
  qty            Int      @default(1)
  amountPaise    BigInt
  overrideReason String?
  meta           Json?

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@map("quotation_items")
}

model Order {
  id                   String             @id @default(uuid(7)) @db.Uuid
  orderNo              String             @unique @db.VarChar(20)
  customerId           String             @db.Uuid
  channel              OrderChannel
  franchiseId          String?            @db.Uuid
  attributionSource    AttributionSource  @default(NONE)
  kioskDeviceId        String?            @db.Uuid
  quotationId          String?            @db.Uuid
  createdBy            String?            @db.Uuid
  status               OrderStatus        @default(PENDING_PAYMENT)
  paymentStatus        OrderPaymentStatus @default(UNPAID)
  paymentMode          PaymentMode        @default(FULL)
  subtotalPaise        BigInt
  discountPaise        BigInt             @default(0)
  installationPaise    BigInt             @default(0)
  deliveryPaise        BigInt             @default(0)
  taxablePaise         BigInt
  cgstPaise            BigInt             @default(0)
  sgstPaise            BigInt             @default(0)
  igstPaise            BigInt             @default(0)
  roundOffPaise        BigInt             @default(0)
  totalPaise           BigInt
  amountPaidPaise      BigInt             @default(0)
  amountDuePaise       BigInt
  advanceRequiredPaise BigInt             @default(0)
  shippingAddress      Json
  billingAddress       Json
  placeOfSupplyState   String             @db.VarChar(2)
  customerGstin        String?            @db.VarChar(15)
  couponId             String?            @db.Uuid
  pricingSnapshot      Json
  installationRequired Boolean            @default(false)
  courierName          String?            @db.VarChar(60)
  awbNo                String?            @db.VarChar(40)
  trackingUrl          String?
  expiresAt            DateTime?          @db.Timestamptz
  confirmedAt          DateTime?          @db.Timestamptz
  completedAt          DateTime?          @db.Timestamptz
  cancelledAt          DateTime?          @db.Timestamptz
  cancelReason         String?
  createdAt            DateTime           @default(now()) @db.Timestamptz
  updatedAt            DateTime           @updatedAt @db.Timestamptz

  customer          User                 @relation("CustomerOrders", fields: [customerId], references: [id])
  franchise         Franchise?           @relation(fields: [franchiseId], references: [id])
  kioskDevice       KioskDevice?         @relation(fields: [kioskDeviceId], references: [id])
  quotation         Quotation?           @relation(fields: [quotationId], references: [id])
  coupon            Coupon?              @relation(fields: [couponId], references: [id])
  items             OrderItem[]
  statusHistory     OrderStatusHistory[]
  payments          Payment[]
  invoices          Invoice[]
  installationJobs  InstallationJob[]
  commissions       Commission[]
  couponRedemptions CouponRedemption[]
  review            Review?
  supportTickets    SupportTicket[]

  @@index([customerId, createdAt(sort: Desc)])
  @@index([franchiseId, createdAt(sort: Desc)])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id                    String      @id @default(uuid(7)) @db.Uuid
  orderId               String      @db.Uuid
  designId              String?     @db.Uuid
  productId             String?     @db.Uuid
  categoryId            String?     @db.Uuid
  description           String
  widthIn               Decimal     @db.Decimal(6, 2)
  heightIn              Decimal     @db.Decimal(6, 2)
  areaSqft              Decimal     @db.Decimal(10, 2)
  billableSqft          Decimal     @db.Decimal(10, 2)
  ratePerSqft           Decimal     @db.Decimal(12, 2)
  addons                Json?
  qty                   Int         @default(1)
  unitPricePaise        BigInt
  lineTaxablePaise      BigInt
  lineInstallationPaise BigInt      @default(0)
  proofStatus           ProofStatus @default(PENDING)
  revisionsUsed         Int         @default(0)

  order    Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  design   Design?       @relation(fields: [designId], references: [id])
  product  Product?      @relation(fields: [productId], references: [id])
  category Category?     @relation(fields: [categoryId], references: [id])
  proofs   DesignProof[]

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id         String       @id @default(uuid(7)) @db.Uuid
  orderId    String       @db.Uuid
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actorId    String?      @db.Uuid
  actorType  String       @db.VarChar(20)
  note       String?
  createdAt  DateTime     @default(now()) @db.Timestamptz

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model DesignProof {
  id              String      @id @default(uuid(7)) @db.Uuid
  orderItemId     String      @db.Uuid
  version         Int
  fileKey         String
  designerNote    String?
  status          ProofStatus @default(PENDING)
  customerComment String?
  uploadedBy      String?     @db.Uuid
  respondedAt     DateTime?   @db.Timestamptz
  createdAt       DateTime    @default(now()) @db.Timestamptz

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@unique([orderItemId, version])
  @@map("design_proofs")
}

model SupportTicket {
  id          String   @id @default(uuid(7)) @db.Uuid
  orderId     String   @db.Uuid
  type        String   @db.VarChar(30)
  description String
  photoKeys   String[]
  status      String   @default("OPEN") @db.VarChar(20)
  resolution  String?
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  order Order @relation(fields: [orderId], references: [id])

  @@map("support_tickets")
}

model Review {
  id        String   @id @default(uuid(7)) @db.Uuid
  orderId   String   @unique @db.Uuid
  userId    String   @db.Uuid
  rating    Int
  comment   String?
  photoKeys String[]
  status    String   @default("PENDING") @db.VarChar(20)
  reply     String?
  createdAt DateTime @default(now()) @db.Timestamptz

  order Order @relation(fields: [orderId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@map("reviews")
}

model Lead {
  id          String     @id @default(uuid(7)) @db.Uuid
  name        String     @db.VarChar(80)
  phone       String     @db.VarChar(15)
  email       String?    @db.VarChar(120)
  pincode     String?    @db.Char(6)
  message     String?
  source      String     @db.VarChar(30)
  status      LeadStatus @default(NEW)
  franchiseId String?    @db.Uuid
  assignedTo  String?    @db.Uuid
  followUpAt  DateTime?  @db.Timestamptz
  createdAt   DateTime   @default(now()) @db.Timestamptz
  updatedAt   DateTime   @updatedAt @db.Timestamptz

  franchise  Franchise?  @relation(fields: [franchiseId], references: [id])
  quotations Quotation[]

  @@index([franchiseId, status])
  @@map("leads")
}

// ─────────────────────────────── Finance ───────────────────────────────

model Payment {
  id               String           @id @default(uuid(7)) @db.Uuid
  orderId          String           @db.Uuid
  purpose          PaymentPurpose
  method           PaymentMethod
  amountPaise      BigInt
  status           PaymentTxnStatus @default(CREATED)
  gatewayOrderId   String?          @db.VarChar(40)
  gatewayPaymentId String?          @unique @db.VarChar(40)
  gatewayMethod    String?          @db.VarChar(20)
  reference        String?          @db.VarChar(60)
  proofKey         String?
  recordedBy       String?          @db.Uuid
  raw              Json?
  capturedAt       DateTime?        @db.Timestamptz
  createdAt        DateTime         @default(now()) @db.Timestamptz
  updatedAt        DateTime         @updatedAt @db.Timestamptz

  order   Order    @relation(fields: [orderId], references: [id])
  refunds Refund[]

  @@index([orderId])
  @@index([gatewayOrderId])
  @@map("payments")
}

model Refund {
  id              String       @id @default(uuid(7)) @db.Uuid
  paymentId       String       @db.Uuid
  amountPaise     BigInt
  reason          String
  status          RefundStatus @default(PENDING)
  gatewayRefundId String?      @unique @db.VarChar(40)
  initiatedBy     String?      @db.Uuid
  createdAt       DateTime     @default(now()) @db.Timestamptz
  updatedAt       DateTime     @updatedAt @db.Timestamptz

  payment Payment @relation(fields: [paymentId], references: [id])

  @@map("refunds")
}

model Invoice {
  id            String      @id @default(uuid(7)) @db.Uuid
  invoiceNo     String      @unique @db.VarChar(30)
  type          InvoiceType @default(TAX_INVOICE)
  orderId       String      @db.Uuid
  refInvoiceId  String?     @db.Uuid
  financialYear String      @db.VarChar(7)
  issuedAt      DateTime    @default(now()) @db.Timestamptz
  seller        Json
  buyer         Json
  lines         Json
  totals        Json
  hsn           String      @db.VarChar(8)
  pdfKey        String?

  order       Order     @relation(fields: [orderId], references: [id])
  refInvoice  Invoice?  @relation("CreditNotes", fields: [refInvoiceId], references: [id])
  creditNotes Invoice[] @relation("CreditNotes")

  @@index([orderId])
  @@map("invoices")
}

model InvoiceSequence {
  financialYear String      @db.VarChar(7)
  type          InvoiceType
  lastNo        Int         @default(0)

  @@id([financialYear, type])
  @@map("invoice_sequences")
}

// ──────────────────────── Franchise & commission ────────────────────────

model FranchiseTier {
  id   String @id @default(uuid(7)) @db.Uuid
  name String @unique @db.VarChar(40)
  sort Int    @default(0)

  franchises      Franchise[]
  commissionRules CommissionRule[]

  @@map("franchise_tiers")
}

model Franchise {
  id                      String          @id @default(uuid(7)) @db.Uuid
  code                    String          @unique @db.VarChar(12)
  name                    String          @db.VarChar(120)
  ownerUserId             String?         @db.Uuid
  tierId                  String?         @db.Uuid
  status                  FranchiseStatus @default(PENDING_KYC)
  address                 Json?
  city                    String          @db.VarChar(80)
  stateCode               String          @db.VarChar(2)
  phone                   String?         @db.VarChar(15)
  email                   String?         @db.VarChar(120)
  gstin                   String?         @db.VarChar(15)
  panEnc                  Bytes?
  bankAccountEnc          Bytes?
  ifsc                    String?         @db.VarChar(11)
  bankName                String?         @db.VarChar(80)
  kycVerifiedAt           DateTime?       @db.Timestamptz
  maxQuoteDiscountPct     Decimal         @default(5) @db.Decimal(5, 2)
  showFullCustomerContact Boolean         @default(false)
  deletedAt               DateTime?       @db.Timestamptz
  createdAt               DateTime        @default(now()) @db.Timestamptz
  updatedAt               DateTime        @updatedAt @db.Timestamptz

  owner            User?                @relation("FranchiseOwner", fields: [ownerUserId], references: [id])
  tier             FranchiseTier?       @relation(fields: [tierId], references: [id])
  users            User[]               @relation("FranchiseUsers")
  territories      FranchiseTerritory[]
  kioskDevices     KioskDevice[]
  commissionRules  CommissionRule[]
  commissions      Commission[]
  payouts          Payout[]
  orders           Order[]
  quotations       Quotation[]
  leads            Lead[]
  technicians      Technician[]
  installationJobs InstallationJob[]
  referralCarts    Cart[]

  @@map("franchises")
}

model FranchiseTerritory {
  id          String @id @default(uuid(7)) @db.Uuid
  franchiseId String @db.Uuid
  pincode     String @unique @db.Char(6)

  franchise Franchise @relation(fields: [franchiseId], references: [id], onDelete: Cascade)

  @@index([franchiseId])
  @@map("franchise_territories")
}

model CommissionRule {
  id               String               @id @default(uuid(7)) @db.Uuid
  scope            CommissionScope
  tierId           String?              @db.Uuid
  franchiseId      String?              @db.Uuid
  categoryId       String?              @db.Uuid
  source           CommissionRuleSource @default(ANY)
  type             CommissionType
  /// percent for PERCENT, paise for FLAT
  value            Decimal              @db.Decimal(12, 2)
  maxPerOrderPaise BigInt?
  priority         Int                  @default(0)
  effectiveFrom    DateTime             @db.Timestamptz
  effectiveTo      DateTime?            @db.Timestamptz
  isActive         Boolean              @default(true)
  createdAt        DateTime             @default(now()) @db.Timestamptz
  updatedAt        DateTime             @updatedAt @db.Timestamptz

  tier      FranchiseTier? @relation(fields: [tierId], references: [id])
  franchise Franchise?     @relation(fields: [franchiseId], references: [id])
  category  Category?      @relation(fields: [categoryId], references: [id])

  @@index([isActive, effectiveFrom])
  @@map("commission_rules")
}

model Commission {
  id           String            @id @default(uuid(7)) @db.Uuid
  orderId      String            @db.Uuid
  franchiseId  String            @db.Uuid
  kind         CommissionKind    @default(ORDER)
  seq          Int               @default(0)
  source       AttributionSource
  basePaise    BigInt
  amountPaise  BigInt
  ruleSnapshot Json
  status       CommissionStatus  @default(PENDING)
  eligibleAt   DateTime?         @db.Timestamptz
  approvedBy   String?           @db.Uuid
  approvedAt   DateTime?         @db.Timestamptz
  payoutId     String?           @db.Uuid
  createdAt    DateTime          @default(now()) @db.Timestamptz
  updatedAt    DateTime          @updatedAt @db.Timestamptz

  order     Order     @relation(fields: [orderId], references: [id])
  franchise Franchise @relation(fields: [franchiseId], references: [id])
  payout    Payout?   @relation(fields: [payoutId], references: [id])

  @@unique([orderId, kind, seq])
  @@index([franchiseId, status])
  @@map("commissions")
}

model Payout {
  id           String       @id @default(uuid(7)) @db.Uuid
  franchiseId  String       @db.Uuid
  periodStart  DateTime     @db.Date
  periodEnd    DateTime     @db.Date
  grossPaise   BigInt
  tdsPaise     BigInt       @default(0)
  netPaise     BigInt
  status       PayoutStatus @default(DRAFT)
  mode         String?      @db.VarChar(20)
  utr          String?      @unique @db.VarChar(40)
  paidAt       DateTime?    @db.Timestamptz
  statementKey String?
  createdBy    String?      @db.Uuid
  createdAt    DateTime     @default(now()) @db.Timestamptz
  updatedAt    DateTime     @updatedAt @db.Timestamptz

  franchise   Franchise    @relation(fields: [franchiseId], references: [id])
  commissions Commission[]

  @@index([franchiseId])
  @@map("payouts")
}

// ───────────────────────────── Field service ─────────────────────────────

model Technician {
  id          String   @id @default(uuid(7)) @db.Uuid
  franchiseId String?  @db.Uuid
  userId      String?  @unique @db.Uuid
  name        String   @db.VarChar(80)
  phone       String   @unique @db.VarChar(15)
  photoKey    String?
  skills      String[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz

  franchise Franchise?        @relation(fields: [franchiseId], references: [id])
  user      User?             @relation(fields: [userId], references: [id])
  jobs      InstallationJob[]

  @@map("technicians")
}

model InstallationJob {
  id                String    @id @default(uuid(7)) @db.Uuid
  orderId           String    @db.Uuid
  franchiseId       String?   @db.Uuid
  technicianId      String?   @db.Uuid
  status            JobStatus @default(UNASSIGNED)
  scheduledStart    DateTime? @db.Timestamptz
  scheduledEnd      DateTime? @db.Timestamptz
  completionOtpHash String?   @db.Char(64)
  completedAt       DateTime? @db.Timestamptz
  failReason        String?
  notes             String?
  createdAt         DateTime  @default(now()) @db.Timestamptz
  updatedAt         DateTime  @updatedAt @db.Timestamptz

  order      Order       @relation(fields: [orderId], references: [id])
  franchise  Franchise?  @relation(fields: [franchiseId], references: [id])
  technician Technician? @relation(fields: [technicianId], references: [id])
  photos     JobPhoto[]

  @@index([technicianId])
  @@index([franchiseId, scheduledStart])
  @@map("installation_jobs")
}

model JobPhoto {
  id        String        @id @default(uuid(7)) @db.Uuid
  jobId     String        @db.Uuid
  stage     JobPhotoStage
  fileKey   String
  createdAt DateTime      @default(now()) @db.Timestamptz

  job InstallationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("job_photos")
}

// ─────────────────────────────── Platform ───────────────────────────────

model NotificationTemplate {
  id                 String              @id @default(uuid(7)) @db.Uuid
  key                String              @db.VarChar(60)
  channel            NotificationChannel
  body               String
  providerTemplateId String?             @db.VarChar(60)
  variables          String[]
  isActive           Boolean             @default(true)

  @@unique([key, channel])
  @@map("notification_templates")
}

model Notification {
  id            String              @id @default(uuid(7)) @db.Uuid
  userId        String?             @db.Uuid
  recipient     String              @db.VarChar(120)
  channel       NotificationChannel
  templateKey   String              @db.VarChar(60)
  payload       Json
  status        NotificationStatus  @default(QUEUED)
  attempts      Int                 @default(0)
  providerMsgId String?             @db.VarChar(80)
  error         String?
  readAt        DateTime?           @db.Timestamptz
  createdAt     DateTime            @default(now()) @db.Timestamptz
  updatedAt     DateTime            @updatedAt @db.Timestamptz

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("notifications")
}

model OutboxEvent {
  id          String    @id @default(uuid(7)) @db.Uuid
  aggregate   String    @db.VarChar(40)
  aggregateId String    @db.Uuid
  event       String    @db.VarChar(60)
  payload     Json
  publishedAt DateTime? @db.Timestamptz
  createdAt   DateTime  @default(now()) @db.Timestamptz

  @@index([publishedAt])
  @@map("outbox_events")
}

model AuditLog {
  id        String   @id @default(uuid(7)) @db.Uuid
  actorId   String?  @db.Uuid
  action    String   @db.VarChar(60)
  entity    String   @db.VarChar(40)
  entityId  String?  @db.VarChar(40)
  before    Json?
  after     Json?
  ip        String?  @db.VarChar(45)
  userAgent String?
  createdAt DateTime @default(now()) @db.Timestamptz

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entity, entityId])
  @@map("audit_logs")
}

model OtpChallenge {
  id         String       @id @default(uuid(7)) @db.Uuid
  phone      String       @db.VarChar(15)
  audience   AuthAudience
  codeHash   String       @db.Char(64)
  attempts   Int          @default(0)
  expiresAt  DateTime     @db.Timestamptz
  consumedAt DateTime?    @db.Timestamptz
  ip         String?      @db.VarChar(45)
  createdAt  DateTime     @default(now()) @db.Timestamptz

  @@index([phone, createdAt])
  @@map("otp_challenges")
}

/// A browser or phone registered for Firebase Cloud Messaging push notifications.
model PushDevice {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @db.Uuid
  token      String   @unique
  app        String   @db.VarChar(20)
  userAgent  String?
  lastSeenAt DateTime @default(now()) @db.Timestamptz
  createdAt  DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_devices")
}
